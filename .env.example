NEXT_PUBLIC_SUPABASE_URL=https://dkehblizesarfzojmbak.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Required only for the Calgary market's online checkout (Stripe Checkout
# Sessions). Get from dashboard.stripe.com/apikeys. Server-side only — never
# prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_your_key_here

# Required to mark Calgary orders as paid after a successful Stripe
# redirect, AND to power the /admin live order dashboard. Get from Supabase
# Dashboard -> Project Settings -> API -> service_role key. Server-side
# only, bypasses RLS — never expose to the client or prefix with
# NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Password for the /admin live order dashboard. Pick anything you like —
# it's the shared password you enter to view incoming orders. Server-side
# only.
ADMIN_PASSWORD=choose_a_password
