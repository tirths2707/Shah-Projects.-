NEXT_PUBLIC_SUPABASE_URL=https://dkehblizesarfzojmbak.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Required only for the Calgary market's online checkout (Stripe Checkout
# Sessions). Get from dashboard.stripe.com/apikeys. Server-side only — never
# prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_your_key_here

# Required to mark Calgary orders as paid after a successful Stripe
# redirect. Get from Supabase Dashboard -> Project Settings -> API ->
# service_role key. Server-side only, bypasses RLS — never expose to the
# client or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
